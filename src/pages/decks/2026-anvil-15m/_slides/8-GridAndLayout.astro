---
import Slide from '@decks/templates/Slide.astro';

// The brief's last question: something you got wrong and what you changed.
// The story gets told live, so this slide only names it and gives the
// panel something to hold while the browser comes up.
---

<Slide hideHeader align="center">
	<div class="flex flex-col items-center gap-4">
		<span class="text-subdued text-xs font-medium uppercase">
			What I got wrong
		</span>
		<div
			class="text-strong text-[144px] leading-none font-medium tracking-[-0.02em]"
		>
			Grid &amp; Layout
		</div>
	</div>
</Slide>
