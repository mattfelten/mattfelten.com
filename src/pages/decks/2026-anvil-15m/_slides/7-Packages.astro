---
import Slide from '@decks/templates/Slide.astro';

const packages = ['tokens', 'fonts', 'icons', 'react'];
---

<Slide subtitle="One monorepo">
	<div class="flex flex-col items-start gap-3">
		<span class="text-subdued text-xs font-medium uppercase">
			Published to npm
		</span>
		<div class="flex flex-col gap-4">
			<div class="text-subdued text-5xl leading-none">packages/</div>
			<ul class="m-0! flex! list-none flex-col gap-4 p-0 pl-12">
				{
					packages.map(name => (
						<li class="text-strong m-0! text-7xl leading-none font-medium tracking-[-0.015em]">
							{name}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Slide>
