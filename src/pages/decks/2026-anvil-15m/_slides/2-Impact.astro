---
import { BleedImage, Slide } from '@decks';
import { RxArrowTopRight } from 'react-icons/rx';

import screenshot from '../images/2 Context.png?url';

// The Project Context slide's form with the Results slide's content.
// Layout is unchanged from 6-ProjectContext.astro in
// 2024-anvil-case-study: three labeled columns across the left half at
// slide (80, 372), the "Online at" row below them, and the docs
// screenshot at 913x923 bleeding bottom-right.
//
// Role / Timeline / Team are gone. The numbers are pulled from the four
// Results cards, keeping the ones that carry weight without needing a
// sentence of setup. Dropped: 3 platforms, 10k variants, 0.16% detach
// rate, 5k installs a week, 250k lines of code, +34 humans.

const columns = [
	{
		label: 'Adoption',
		items: ['71% of 32 teams', '385 users', '77% CSAT'],
	},
	{
		label: 'Efficiency',
		items: ['+$5.3M per year', '65% design time', '30% dev time'],
	},
	{
		label: 'Scale',
		items: ['55 components', '37 contributors', '40k inserts a month'],
	},
];

const url = 'https://v1.anvil.servicetitan.com';
---

<Slide subtitle="Impact">
	<div class="flex flex-col gap-12">
		<div class="grid w-1/2 grid-cols-3 gap-x-4">
			{
				columns.map(col => (
					<div>
						<div class="text-strong text-2xl font-medium">
							{col.label}
						</div>
						<ul class="m-0! mt-2 list-none p-0">
							{col.items.map(item => (
								<li class="text-subdued my-1 text-2xl leading-[40px] font-medium">
									{item}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<div class="flex flex-col items-start gap-1">
			<span class="text-subdued text-xs font-medium uppercase"
				>Online at</span
			>
			<a href={url} class="text-default relative text-2xl"
				>{url}<RxArrowTopRight
					className="text-weak absolute top-0.5 -right-4 inline-block align-text-top"
				/></a
			>
		</div>
	</div>
	<BleedImage
		src={screenshot}
		alt="Anvil Design System documentation site"
		bleed={['right', 'bottom']}
		class="h-[923px] w-[913px] object-cover"
	/>
</Slide>
