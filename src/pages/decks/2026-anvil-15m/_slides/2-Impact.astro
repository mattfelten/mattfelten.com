---
import CardGridSlide from '@decks/templates/CardGridSlide.astro';

// Every metric in the deck lives here. Architecture and Figma Components
// used to carry a few each, which split the evidence across three slides
// and made none of them land. Those are image-led now and this is the
// one place numbers appear.
//
// 2x2 on the CardGridSlide primitive, which is what 24-Results.astro in
// 2024-anvil-case-study used. Four cards hold all fourteen data points
// with room to breathe, and four buckets is about the most that can be
// walked through in the sixty to ninety seconds this slide gets.
//
// ROI is deliberately the short card. Two lines next to three fuller
// ones is what makes the money number the thing the eye lands on.
//
// The time-saved figures stay with the tool they were measured in rather
// than being pooled into ROI, since 65% was design time in Figma and 30%
// was engineering time in code.
//
// For a 3x2 instead, split Adoption into Adoption and Satisfaction, and
// pull the time-saved lines out into their own card, then pass
// size="small" to the Cards so six don't crowd.
---

<CardGridSlide
	subtitle="Impact"
	cards={[
		{
			title: 'Adoption',
			items: [
				'71% of 32 teams',
				'385 users',
				'77% CSAT',
				'37 contributors',
			],
		},
		{
			title: 'ROI',
			items: ['+$5.3M per year', '+34 humans'],
		},
		{
			title: 'Figma',
			items: [
				'55 components, 10k variants',
				'40k inserts a month',
				'0.16% detach rate',
				'65% design time saved',
			],
		},
		{
			title: 'Code',
			items: [
				'5k installs a week',
				'250k lines of code',
				'30% dev time saved',
				'3 platforms: Web, iOS, Android',
			],
		},
	]}
/>
