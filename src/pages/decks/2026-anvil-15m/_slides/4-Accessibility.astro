---
import Slide from '@decks/templates/Slide.astro';

// Three-column layout borrowed from 9-Personas.astro in
// 2024-anvil-case-study: same grid, same gap, same heading + <dl> shape,
// with the avatar dropped. Each column is one layer of the accessibility
// approach rather than one person.
//
// The layer names and the three-layer framing are Matt's. The split of
// considerations across them is inferred from the 2024 deck's own
// Accessibility and Documentation slides, so it is the first thing to
// correct if it doesn't match how it actually worked.

interface Layer {
	name: string;
	meaning: string;
	considerations: string[];
}

const layers: Layer[] = [
	{
		name: 'Baked in',
		meaning: 'The component handles it, so teams never have to.',
		considerations: [
			'Color Contrast',
			'UX Affordances',
			'Responsiveness',
			'Various Input Devices',
		],
	},
	{
		name: 'Documented',
		meaning: 'Every component page says what to watch for.',
		considerations: [
			'Accessibility Considerations',
			'Content Guidelines',
			'Localisation',
		],
	},
	{
		name: 'Verified',
		meaning: 'Checked by hand before it ships.',
		considerations: [
			'Screen Readers',
			'Color Vision Simulation',
			'Manual Review',
		],
	},
];
---

<Slide subtitle="Accessibility">
	<div class="grid grid-cols-3 gap-x-14">
		{
			layers.map(layer => (
				<div class="flex flex-col items-start gap-6">
					<h3 class="text-strong m-0! text-4xl leading-none font-medium">
						{layer.name}
					</h3>
					<dl class="m-0 grid grid-cols-1 gap-4">
						<div>
							<dt class="text-strong text-xl font-medium">
								What it means
							</dt>
							<dd class="text-subdued m-0 mt-1 text-2xl leading-[1.3]">
								{layer.meaning}
							</dd>
						</div>
						<div>
							<dt class="text-strong text-xl font-medium">
								Considerations
							</dt>
							<dd class="m-0 mt-1">
								<ul class="text-subdued m-0! list-none p-0 text-2xl">
									{layer.considerations.map(item => (
										<li class="leading-[1.3]">{item}</li>
									))}
								</ul>
							</dd>
						</div>
					</dl>
				</div>
			))
		}
	</div>
</Slide>
