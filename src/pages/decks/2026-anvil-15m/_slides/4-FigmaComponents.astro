---
import { BleedImage, Slide } from '@decks';

import screenshot from '../images/16 Figma Components.png?url';

// Image-led, paired with 3-Architecture.astro. Together they answer how
// the system was distributed and consumed: npm for engineers, Figma
// libraries for designers. The decisions get spoken over the artwork.
//
// The inserts and detach-rate numbers that used to sit here in a facts
// row moved to 2-Impact.astro, where all the metrics now live.
//
// Source is 1819x883. Scaled to 1760x854, which keeps the aspect exactly
// so object-cover crops nothing, fills the slide width inside the 80px
// gutters, and bleeds off the bottom edge. Top of the image lands at
// y=226, clear of the header.
---

<Slide subtitle="Figma Components">
	<BleedImage
		src={screenshot}
		alt="Button component variants in Figma across Secondary, Primary, and Destructive colors with fills, states, and loading"
		bleed="bottom"
		class="h-[854px] w-[1760px] object-cover"
	/>
</Slide>
