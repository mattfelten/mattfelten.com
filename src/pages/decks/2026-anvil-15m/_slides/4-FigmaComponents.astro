---
import Slide from '@decks/templates/Slide.astro';

import screenshot from '../images/16 Figma Components.png?url';

// The designer half of "distributed and consumed", paired with
// 3-Architecture.astro. Same facts row, same 1400px visual footprint.
//
// The numbers moved here off the Impact slide on purpose. Next to the
// components they stop being trivia and become evidence that people
// actually consumed the library as intended. The detach rate is the
// strongest of the three.
//
// Source image is 1819x883, scaled to 1400x679 to leave room for the
// facts row above it.

const facts = [
	{ label: 'Distribution', value: 'Shared libraries' },
	{ label: 'Consumption', value: '40k inserts a month' },
	{ label: 'Fidelity', value: '0.16% detach rate' },
];
---

<Slide subtitle="Figma Components">
	<div class="flex flex-col items-center gap-6">
		<div class="flex w-[1400px] gap-12">
			{
				facts.map(fact => (
					<div class="flex flex-col gap-1">
						<span class="text-subdued text-xs font-medium uppercase">
							{fact.label}
						</span>
						<span class="text-strong text-3xl font-medium">
							{fact.value}
						</span>
					</div>
				))
			}
		</div>
		<img
			src={screenshot}
			alt="Button component variants in Figma across Secondary, Primary, and Destructive colors with fills, states, and loading"
			class="m-0! block h-[679px] max-h-none! w-[1400px] max-w-none! rounded-2xl"
		/>
	</div>
</Slide>
