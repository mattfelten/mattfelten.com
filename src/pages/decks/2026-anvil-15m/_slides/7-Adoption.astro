---
import Slide from '@decks/templates/Slide.astro';

import pilot from '../images/5 Personas 1.svg?url';
import champions from '../images/5 Personas 2.svg?url';
import roadmap from '../images/5 Personas 6.svg?url';

// Answers the brief's hardest question: adoption when nobody was required
// to use it. Release and Contribution are what kept the system healthy
// once teams had opted in; this is the slide about getting them to opt in.
//
// Same three-column grid as 8-Accessibility.astro, but with the Personas
// faces instead of the abstract Why Me shapes, since this beat is about
// people rather than practices. Personas are 106px tall against the Why Me
// set's 115px, so the illustration height is set to match the source.
//
// Content is drawn from Matt's own framing: one pilot team, a basic first
// release that became the internal case study, then Anvil experts embedded
// across teams following the roadmap and changelog. The third column is
// the loosest inference of the three and is the first thing to correct.

interface Beat {
	name: string;
	icon: string;
	items: string[];
}

const beats: Beat[] = [
	{
		name: 'Pilot team',
		icon: pilot,
		items: [
			'One team first',
			'Basic first release',
			'The internal case study',
		],
	},
	{
		name: 'Champions',
		icon: champions,
		items: ['Experts in each team', 'Embedded across teams'],
	},
	{
		name: 'Roadmap',
		icon: roadmap,
		items: ['Shared roadmap', 'Release changelog'],
	},
];
---

<Slide subtitle="Adoption">
	<div class="grid grid-cols-3 gap-14">
		{
			beats.map(beat => (
				<div class="flex flex-col items-start gap-13">
					<img
						src={beat.icon}
						alt=""
						class="m-0! block h-[106px] w-auto"
					/>
					<div class="flex flex-col gap-3">
						<div class="text-strong text-4xl leading-[40px] font-medium">
							{beat.name}
						</div>
						<ul class="text-subdued m-0! list-none p-0 text-2xl">
							{beat.items.map(item => (
								<li class="leading-[1.4]">{item}</li>
							))}
						</ul>
					</div>
				</div>
			))
		}
	</div>
</Slide>
