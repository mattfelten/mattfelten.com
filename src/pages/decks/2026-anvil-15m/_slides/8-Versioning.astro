---
import Slide from '@decks/templates/Slide.astro';

// The repeated number is the whole slide. Nothing says "lockstep" in words.
// `version` is illustrative, swap it for a real one if you'd rather.
const packages = ['tokens', 'fonts', 'icons', 'react'];
const version = '4.2.0';
---

<Slide subtitle="Versioning">
	<ul class="m-0! flex! list-none flex-col gap-4 p-0">
		{
			packages.map(name => (
				<li class="m-0! flex items-baseline gap-8 text-5xl leading-none">
					<span class="text-subdued w-[280px]">{name}</span>
					<span class="text-strong font-medium tabular-nums">
						{version}
					</span>
				</li>
			))
		}
	</ul>
</Slide>
