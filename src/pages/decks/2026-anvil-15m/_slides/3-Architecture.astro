---
import Slide from '@decks/templates/Slide.astro';

// Image-led. The diagram carries the slide and the decisions get spoken
// over it: npm packages, lockstep versioning and what that cost, and why
// this shape rather than a single package or a repo per component.
//
// The metrics that used to sit here in a facts row moved to 2-Impact.astro.
// Splitting the numbers across three slides meant none of them landed.
//
// PLACEHOLDER — the diagram is the one asset this deck still needs.
// To swap it in:
// 1. Drop the file at ../images/architecture.png
// 2. Replace the frontmatter imports with:
//      import { BleedImage, Slide } from '@decks';
//      import architecture from '../images/architecture.png?url';
// 3. Replace the placeholder <div> below with, sized to the source:
//      <BleedImage
//          src={architecture}
//          alt="Anvil architecture: tokens feeding fonts, icons, and React components"
//          bleed="bottom"
//          class="h-[854px] w-[1760px] object-cover"
//      />
//    That matches the footprint 4-FigmaComponents.astro uses, which keeps
//    the two consumption slides reading as a pair. Use ImageSlide instead
//    if the diagram is tall rather than wide.
---

<Slide subtitle="Architecture">
	<div
		class="border-weak/[0.18] absolute top-[228px] right-7 bottom-7 left-7 flex items-center justify-center rounded-[20px] border border-dashed"
	>
		<span class="text-weak text-xs font-medium uppercase">
			Architecture diagram
		</span>
	</div>
</Slide>
