---
import Slide from '@decks/templates/Slide.astro';
import { RxArrowRight } from 'react-icons/rx';
---

<Slide subtitle="How it started">
	<div class="flex flex-col gap-6">
		<div class="flex items-center gap-8">
			<div class="text-subdued text-7xl leading-none tracking-[-0.015em]">
				Product designer
			</div>
			<RxArrowRight className="text-accent shrink-0" size={64} />
			<div
				class="text-strong text-7xl leading-none font-medium tracking-[-0.015em]"
			>
				Design system
			</div>
		</div>
		<div class="text-subdued text-3xl leading-none">Team of one.</div>
	</div>
</Slide>
