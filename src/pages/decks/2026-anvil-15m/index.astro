---
import { Deck, DeckShell } from '@decks';

import {
	Accessibility,
	Adoption,
	Architecture,
	Contribution,
	FigmaComponents,
	GridAndLayout,
	Impact,
	Release,
	ThankYou,
	Title,
} from './_slides';

const meta = {
	title: 'Anvil Design System',
	description:
		'Anvil Design System, told as answers to the five things the panel asked about: distribution, contribution, adoption, accessibility, and what went wrong.',
};

// A 15-minute recorded talk. The panel asked five specific questions and
// said they wanted the decisions rather than the look, so the deck is
// ordered as answers to those questions instead of as a case study.
//
//   Distributed and consumed, and why  →  3, 4, 5
//   A pattern the system lacked, promoted to core  →  6
//   Adoption with no mandate  →  7
//   Accessibility  →  8
//   Something got wrong, and what changed  →  9, told live
//
// Roughly three minutes a question. Impact opens as credibility rather
// than as an answer, since metrics weren't among the five.
//
// Slides are copied from 2024-anvil-case-study rather than imported, and
// their images copied into ./images, per the freezing principle: that
// deck stays put, this one can drift. Release and Contribution are
// verbatim copies; everything else is new or reworked.
//
// Design Process was cut. It described how the work ran generally and
// answered none of the five.
//
// Architecture is still a placeholder and is the one asset this deck
// needs before it can be recorded.
---

<DeckShell {...meta}>
	<Deck title="Anvil Design System">
		<Title />
		<Impact />
		<Architecture />
		<FigmaComponents />
		<Release />
		<Contribution />
		<Adoption />
		<Accessibility />
		<GridAndLayout />
		<ThankYou />
	</Deck>
</DeckShell>
