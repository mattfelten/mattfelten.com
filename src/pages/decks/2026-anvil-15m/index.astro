---
import { Deck, DeckShell } from '@decks';

import {
	Accessibility,
	Adoption,
	Architecture,
	FigmaComponents,
	GridAndLayout,
	Impact,
	Release,
	ThankYou,
	Title,
} from './_slides';

const meta = {
	title: 'Anvil Design System',
	description:
		'Anvil Design System, told as answers to the five things the panel asked about: distribution, contribution, adoption, accessibility, and what went wrong.',
};

// A 15-minute recorded talk. The panel asked five specific questions and
// said they wanted the decisions rather than the look, so the deck is
// ordered as answers to those questions instead of as a case study.
//
//   Distributed and consumed, and why  →  3, 4, 5
//   A pattern the system lacked, promoted to core  →  spoken, over 6
//   Adoption with no mandate  →  6
//   Accessibility  →  7
//   Something got wrong, and what changed  →  8, told live
//
// The contribution question has no slide of its own. It is carried by
// "Contribution Docs" and "Design & Code Review" in the Adoption slide's
// Org Support column, and told out loud. If it needs a slide again,
// 22-Contribution.astro in 2024-anvil-case-study is the one that was
// here, and its image is still in ./images.
//
// Slides are copied from 2024-anvil-case-study rather than imported, and
// their images copied into ./images, per the freezing principle: that
// deck stays put, this one can drift. Release is the only verbatim copy
// left; everything else is new or reworked.
//
// Architecture is still a placeholder and is the one asset this deck
// needs before it can be recorded.
---

<DeckShell {...meta}>
	<Deck title="Anvil Design System">
		<Title />
		<Impact />
		<Architecture />
		<FigmaComponents />
		<Release />
		<Adoption />
		<Accessibility />
		<GridAndLayout />
		<ThankYou />
	</Deck>
</DeckShell>
