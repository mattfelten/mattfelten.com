---
import { Deck, DeckShell } from '@decks';

import {
	Accessibility,
	DesignProcess,
	ProjectContext,
	Release,
	Results,
	ThankYou,
	Title,
} from './_slides';

const meta = {
	title: 'Anvil Design System',
	description: 'Anvil Design System case study, cut to 15 minutes.',
};

// A 15-minute cut of the 2024 Anvil case study for a recorded interview
// talk. Every slide is copied from 2024-anvil-case-study rather than
// imported, per the freezing principle: that deck stays put, this one can
// drift. Images are copied into ./images for the same reason.
//
// The only edit to any copied slide is the Accessibility subtitle, which
// drops the "Exploration →" prefix since this cut has no Exploration
// section for it to belong to.
//
// No TOC interstitials. At seven slides the sections are too short to
// survive being announced.
---

<DeckShell {...meta}>
	<Deck title="Anvil Design System">
		<Title />
		<ProjectContext />
		<DesignProcess />
		<Accessibility />
		<Release />
		<Results />
		<ThankYou />
	</Deck>
</DeckShell>
