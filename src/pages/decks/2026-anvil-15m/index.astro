---
import { Deck, DeckShell } from '@decks';

import {
	Accessibility,
	Architecture,
	Contribution,
	DesignProcess,
	FigmaComponents,
	ProjectContext,
	Release,
	Results,
	ThankYou,
	Title,
} from './_slides';

const meta = {
	title: 'Anvil Design System',
	description: 'Anvil Design System case study, cut to 15 minutes.',
};

// A 15-minute cut of the 2024 Anvil case study for a recorded interview
// talk. Slides are copied from 2024-anvil-case-study rather than imported,
// and their images copied into ./images, per the freezing principle: that
// deck stays put, this one can drift.
//
// The arc: who and what (1-2), how the work ran (3), how the system is
// structured (4), the design craft on top of it (5-6), how it shipped (7),
// how it grew (8), what it achieved (9).
//
// Edits to copied slides, both dropping a phase prefix this cut has no
// section for: "Exploration → Accessibility" became "Accessibility", and
// "Refinement → Figma Components" became "Figma Components".
//
// Two slides are not from the 2024 deck:
//   - Accessibility, rebuilt as three layers on the Personas grid.
//   - Architecture, still a placeholder. Nothing in the 2024 deck covers
//     it, so it needs a diagram before this is recorded.
//
// No TOC interstitials. At ten slides the sections are too short to
// survive being announced.
---

<DeckShell {...meta}>
	<Deck title="Anvil Design System">
		<Title />
		<ProjectContext />
		<DesignProcess />
		<Architecture />
		<FigmaComponents />
		<Accessibility />
		<Release />
		<Contribution />
		<Results />
		<ThankYou />
	</Deck>
</DeckShell>
