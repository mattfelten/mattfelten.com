---
import Slide from '@decks/templates/Slide.astro';

// The visual anchor of the deck. Five numbers in a single band centered on
// the slide midpoint, nothing above or below them. 88px keeps "$5.3M"
// inside its 312px column ((1760 - 4x48) / 5).
const stats = [
	{ value: '32', label: 'product teams' },
	{ value: '385', label: 'users' },
	{ value: '37', label: 'contributors' },
	{ value: '71%', label: 'adoption' },
	{ value: '$5.3M', label: 'annual efficiency gains' },
];
---

<Slide subtitle="Scale">
	<div class="grid grid-cols-5 gap-5">
		{
			stats.map(stat => (
				<div class="flex flex-col gap-3">
					<div class="text-strong text-[88px] leading-none font-medium tracking-[-0.02em]">
						{stat.value}
					</div>
					<div class="text-subdued text-2xl leading-snug">
						{stat.label}
					</div>
				</div>
			))
		}
	</div>
</Slide>
