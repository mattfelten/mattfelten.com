---
import Slide from '@decks/templates/Slide.astro';

// Statement slide, same genre as 10-ProblemStatement.astro in
// 2024-anvil-case-study: subdued sentence, strong on the load-bearing
// clause. <div> rather than <p> so Tailwind's leading wins over
// `.reveal p { line-height: 1.45 }`.
---

<Slide hideHeader align="center">
	<div
		class="text-subdued [&>strong]:text-strong max-w-[1400px] text-7xl leading-[1.16] tracking-[-0.015em] [&>strong]:font-medium"
	>
		A design system <strong>isn’t every piece of code</strong> in the app.
	</div>
</Slide>
