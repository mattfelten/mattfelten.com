---
import { Deck, DeckShell } from '@decks';

import {
	Accessibility,
	AdoptionChampions,
	AdoptionPilot,
	Architecture,
	DesignTooling,
	HowItStarted,
	Packages,
	Scale,
	Scope,
	ThankYou,
	TheGap,
	Title,
	TwentyNinePercent,
	Versioning,
	WhatItWas,
} from './_slides';

const meta = {
	title: 'Anvil',
	description:
		'Anvil, the design system at ServiceTitan: the decisions behind it, what each one cost, and what it bought.',
};

// 15-minute recorded interview talk for a panel of designers and engineers.
// The brief was "less about what the system looks like and more about the
// decisions behind it", so every slide is one idea and nothing on screen
// repeats what gets said out loud.
//
// Deliberate departure from decks/CLAUDE.md: no TOC interstitials and no
// About Me act. The talk is a single continuous run and the sections are too
// short to survive being announced. Act III is just the closing slide.
//
// Sections 5-7 of the talk happen in a live browser and on camera. There are
// no slides marking those switches, so the deck runs straight through to the
// closing slide.
---

<DeckShell {...meta}>
	<Deck title="Anvil">
		<Title />
		<WhatItWas />
		<HowItStarted />
		<Scale />
		<TwentyNinePercent />
		<Architecture />
		<Packages />
		<Versioning />
		<DesignTooling />
		<Accessibility />
		<TheGap />
		<AdoptionPilot />
		<AdoptionChampions />
		<Scope />
		<ThankYou />
	</Deck>
</DeckShell>
