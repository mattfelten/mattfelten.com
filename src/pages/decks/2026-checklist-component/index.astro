---
import { Deck, DeckShell } from '@decks';

import {
	AskEdit,
	AskMultiplayer,
	AskReorder,
	AskSubItems,
	BiggerTargets,
	DocsForAgents,
	DocsForHumans,
	EightArrangements,
	FourPrimitives,
	HowItGotDecided,
	InvisibleField,
	MergeAndGarble,
	MyRole,
	PickingUpARow,
	Presence,
	RuledOutCascade,
	RuledOutDim,
	RuledOutEditorObject,
	RuledOutFullProxy,
	RuledOutHairline,
	RuledOutLock,
	RuledOutShift,
	RuledOutSidewaysDrag,
	Runbooks,
	ShippedAndFailing,
	SubItems,
	TheRowArbitrates,
	TheRowToday,
	ThankYou,
	ThreeGestures,
	Title,
	TwoTickets,
	WhatILandedOn,
	WhereItLanded,
	WhereThisLives,
	WithoutAMouse,
	WordsNeverMove,
} from './_slides';

const meta = {
	title: 'Checklist',
	description:
		'A checkable, orderable, editable row in Collaboration Loops, taken from two tickets to an approved design system component. The argument is depth: this is the simplest thing in the product, and getting it right took 33 decisions, 35 rejected directions, and a pile of measurements that a mockup could never have produced.',
};

// The narrative lives in _outline.md. Edit that first, then the slides.
//
// ~18 minutes, third segment of a portfolio review (intro, Anvil
// overview, this, outro). Roughly 20 seconds a slide, with five moments
// driven live: 4, 11, 16, 27, 29.
//
// Follows an Anvil overview, so nothing here re-explains design systems,
// and the accessibility beat has to read as component depth rather than
// the system-level policy Anvil already covered.
//
// Shape: where it was, what people kept asking for, Runbooks as the
// second consumer, what I landed on, then each feature with the dead
// ends it produced, then accessibility as the thing that settles the
// central conflict, then the decomposition and the docs, then where it
// landed.
//
// Four slides are placeholders and are deliberately loud on screen:
// grep -rn Placeholder _slides/
---

<DeckShell {...meta}>
	<Deck title="Checklist">
		<Title />
		<MyRole />
		<WhereThisLives />
		<TheRowToday />

		<AskReorder />
		<AskEdit />
		<AskSubItems />
		<AskMultiplayer />
		<TwoTickets />
		<Runbooks />

		<WhatILandedOn />
		<HowItGotDecided />

		<InvisibleField />
		<RuledOutEditorObject />
		<RuledOutHairline />
		<WordsNeverMove />

		<PickingUpARow />
		<RuledOutShift />
		<RuledOutFullProxy />

		<SubItems />
		<RuledOutSidewaysDrag />
		<RuledOutCascade />

		<Presence />
		<RuledOutDim />
		<RuledOutLock />
		<MergeAndGarble />

		<ThreeGestures />
		<EightArrangements />

		<WithoutAMouse />
		<ShippedAndFailing />
		<BiggerTargets />

		<FourPrimitives />
		<TheRowArbitrates />

		<DocsForHumans />
		<DocsForAgents />
		<WhereItLanded />
		<ThankYou />
	</Deck>
</DeckShell>
