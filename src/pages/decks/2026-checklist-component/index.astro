---
import { Deck, DeckShell } from '@decks';

import {
	AccessibilityAudit,
	AccessibilitySection,
	AccessibleImplementation,
	Before,
	ComponentAPI,
	ComponentStructure,
	Docs,
	EditingFinal,
	EditingSection,
	Implementation,
	MultiplayerFinal,
	MultiplayerSection,
	NestedFinal,
	NestedSection,
	ObjectTypes,
	ReorderingFinal,
	ReorderingSection,
	RuledOutCascade,
	RuledOutDeepNesting,
	RuledOutEditorOpens,
	RuledOutFullProxy,
	RuledOutHairline,
	RuledOutHighlight,
	RuledOutLock,
	RuledOutShift,
	SystemSection,
	ThankYou,
	Title,
	WhatsNext,
	WhereWeLanded,
	WhyAComponent,
} from './_slides';

const meta = {
	title: 'Checklist',
	description:
		'A checkable, orderable, editable row in Collaboration Loops, taken from two tickets to an approved design system component. The argument is depth: this is the simplest thing in the product, and getting it right took 33 decisions and 35 rejected directions that a mockup could never have produced.',
};

// Narrative lives in _outline.md. Edit that first.
//
// Shape: before, why it is a component, where we landed, then one
// section per feature. Each section opens with a title slide, shows the
// settled answer, then the directions that were ruled out. Then
// accessibility, the system, the docs, and where it landed.
//
// Feature sections are Editing, Reordering, Nested items, Multiplayer.
//
// Two slides are placeholders, and both are a conversation before they
// are work: the primitives diagram and the docs slide.
//   grep -rn Placeholder _slides/
---

<DeckShell {...meta}>
	<Deck title="Checklist">
		<Title />
		<Before />
		<WhyAComponent />
		<WhereWeLanded />

		<EditingSection />
		<EditingFinal />
		<RuledOutEditorOpens />
		<RuledOutHairline />

		<ReorderingSection />
		<ReorderingFinal />
		<RuledOutShift />
		<RuledOutFullProxy />

		<NestedSection />
		<NestedFinal />
		<RuledOutDeepNesting />
		<RuledOutCascade />

		<MultiplayerSection />
		<MultiplayerFinal />
		<RuledOutLock />
		<RuledOutHighlight />

		<AccessibilitySection />
		<AccessibilityAudit />
		<AccessibleImplementation />

		<SystemSection />
		<ComponentStructure />
		<ComponentAPI />
		<ObjectTypes />
		<Implementation />

		<Docs />
		<WhatsNext />
		<ThankYou />
	</Deck>
</DeckShell>
