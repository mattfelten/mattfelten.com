---
import { Deck, DeckShell } from '@decks';

import {
	AccessibilityDecisions,
	AccessibilitySection,
	Before,
	Docs,
	EditingFinal,
	EditingSection,
	MultiplayerFinal,
	MultiplayerSection,
	NestedFinal,
	NestedSection,
	Primitives,
	ReorderingFinal,
	ReorderingSection,
	RuledOutCascade,
	RuledOutDeepNesting,
	RuledOutDim,
	RuledOutEditorOpens,
	RuledOutFullProxy,
	RuledOutHairline,
	RuledOutLock,
	RuledOutShift,
	SystemSection,
	TheRowArbitrates,
	ThankYou,
	Title,
	WhereItLanded,
	WhereWeLanded,
	WhyAComponent,
} from './_slides';

const meta = {
	title: 'Checklist',
	description:
		'A checkable, orderable, editable row in Collaboration Loops, taken from two tickets to an approved design system component. The argument is depth: this is the simplest thing in the product, and getting it right took 33 decisions and 35 rejected directions that a mockup could never have produced.',
};

// Narrative lives in _outline.md. Edit that first.
//
// Shape: before, why it is a component, where we landed, then one
// section per feature. Each section opens with a title slide, shows the
// settled answer, then the directions that were ruled out. Then
// accessibility, the system, the docs, and where it landed.
//
// Feature sections are Editing, Reordering, Nested items, Multiplayer.
//
// Eleven slides are placeholders, and most of them are blocked on
// prototype work rather than on writing:
//   grep -rn Placeholder _slides/
---

<DeckShell {...meta}>
	<Deck title="Checklist">
		<Title />
		<Before />
		<WhyAComponent />
		<WhereWeLanded />

		<EditingSection />
		<EditingFinal />
		<RuledOutEditorOpens />
		<RuledOutHairline />

		<ReorderingSection />
		<ReorderingFinal />
		<RuledOutShift />
		<RuledOutFullProxy />

		<NestedSection />
		<NestedFinal />
		<RuledOutDeepNesting />
		<RuledOutCascade />

		<MultiplayerSection />
		<MultiplayerFinal />
		<RuledOutDim />
		<RuledOutLock />

		<AccessibilitySection />
		<AccessibilityDecisions />

		<SystemSection />
		<Primitives />
		<TheRowArbitrates />

		<Docs />
		<WhereItLanded />
		<ThankYou />
	</Deck>
</DeckShell>
