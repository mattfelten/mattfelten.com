---
import { Deck, DeckShell, TocSlide } from '@decks';

import {
	AccessibilityAudit,
	AccessibilitySection,
	AnvilAccessibility,
	AnvilAdoption,
	AnvilCodeArchitecture,
	AnvilDocumentation,
	AnvilFigmaLibraries,
	AnvilFourLayers,
	AnvilKeyDecisions,
	AnvilOverview,
	AnvilPriorArt,
	AnvilWhatIdDoDifferently,
	AnvilWhatIsServiceTitan,
	Before,
	ComponentAPI,
	ComponentSection,
	ComponentStructure,
	DesignPrinciples,
	Docs,
	Explorations,
	Implementation,
	MultiplayerFinal,
	NextSteps,
	RuledOutEditorOpens,
	RuledOutLock,
	RuledOutShift,
	ThankYou,
	Title,
	WhereWeLanded,
	WhoIAm,
	WhyAComponent,
	WhyMe,
	WorkHistory,
} from './_slides';

const meta = {
	title: 'Design System Portfolio',
	description:
		'A design system at breadth and one component at depth. Anvil is the system argument: how it was distributed, adopted without a mandate, and made accessible. Checklist is the same care applied to the simplest thing in the product, where 33 decisions and 35 rejected directions came out of prototypes a mockup could never have produced.',
};

// The whole 45 minutes. Grew out of the Checklist deck rather than into a
// new folder, which is Matt's call. Only the folder name still says
// "checklist-component"; nothing on screen does.
//
// Three different strings, and they are easy to confuse:
//
//   meta.title          "Design System Portfolio"
//     The deck's name. DeckShell appends the byline itself, so the tab
//     reads "Design System Portfolio → Matt Felten" and the title slide
//     reads "Matt Felten / Design System Portfolio". Putting the name in
//     meta.title as well would print it twice.
//
//   <Deck title=>       "Checklist Component"
//     The per-slide header fallback, so it is really the SEGMENT name.
//     It reaches only the Checklist content slides: everything else in
//     this deck passes its own title or hides the header, which is the
//     Act I and Act III kit working as decks/CLAUDE.md describes it.
//     Renaming the segment is therefore this one string, not 23 files.
//
//   toc[]               "Checklist Component"
//     The interstitial. Keep it identical to <Deck title=> or the
//     section is called two things ten seconds apart.
//
// Shape and the timing it is built against, 45 minutes with questions:
//
//   About Me                4 slides    about 3 min
//   Anvil Design System    11 slides    about 13 min
//   Checklist              16 slides    about 10 min
//   Closing                 2 slides    about 2 min
//
// The Checklist segment was cut roughly in half (Matt, 2026-09-15). It
// used to spend eight slides on eight rejected directions, one each, on
// the argument that summarising them as a number throws the evidence
// away. That was right about the evidence and wrong about the medium.
// Three rejections keep slides because three arguments are worth
// hearing in full; the rest are on the explorations index, which is
// embedded whole on slide 27 and says "thirty-two questions, every
// variation" in one move.
//
// Gone with them: the Editing, Reordering and Nested Items sections and
// their live slides. Final Component already demonstrates all three.
//
// The two segments are paced very differently on purpose: Anvil is
// diagram slides that get talked over for a minute each, Checklist is
// short slides with live prototypes that get driven for twenty to thirty
// seconds. Do not try to even them out.
//
// The Anvil segment has an argument and is ordered around it. Slide 11
// states the decisions; 12 to 16 are the evidence for selected ones, in
// the order how it is built, how it stays in sync, what is guaranteed
// inside it, how you learn it, how people came to it. 17 and 18 are the
// reflection, and 17 pays off slide 11 rather than introducing anything
// new.
//
// Anvil comes first because Checklist is the zoom-in counterpart. The
// system argument has to be on the table before the component depth
// means anything, and accessibility lands twice on purpose: once at
// system level on slide 14, once inside one component on slide 40.
//
// The Checklist segment keeps its own internal section slides rather
// than TOC interstitials. That is a settled decision from its own review
// and it reads as a deck within a deck, which is what it is. The TOC
// interstitials here are top level only.
//
// Narrative lives in _outline.md. Edit that first.

const toc = ['About Me', 'Anvil Design System', 'Checklist Component', 'Closing'];
---

<DeckShell {...meta}>
	<Deck title="Checklist Component">
		<Title />

		<TocSlide items={toc} />

		<TocSlide items={toc} active="About Me" />
		<WhoIAm />
		<WorkHistory />
		<DesignPrinciples />

		<TocSlide items={toc} active="Anvil Design System" />
		<AnvilWhatIsServiceTitan />
		<AnvilOverview />
		<AnvilPriorArt />
		<AnvilKeyDecisions />
		<AnvilCodeArchitecture />
		<AnvilFigmaLibraries />
		<AnvilAccessibility />
		<AnvilDocumentation />
		<AnvilAdoption />
		<AnvilFourLayers />
		<AnvilWhatIdDoDifferently />

		<TocSlide items={toc} active="Checklist Component" />
		<Before />
		<WhyAComponent />
		<WhereWeLanded />
		<MultiplayerFinal />

		<RuledOutShift />
		<RuledOutLock />
		<RuledOutEditorOpens />
		<Explorations />

		<AccessibilitySection />
		<AccessibilityAudit />

		<ComponentSection />
		<ComponentStructure />
		<ComponentAPI />
		<Implementation />

		<Docs />
		<NextSteps />

		<TocSlide items={toc} active="Closing" />
		<WhyMe />
		<ThankYou />
	</Deck>
</DeckShell>
