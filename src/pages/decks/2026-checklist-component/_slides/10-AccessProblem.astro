---
import Slide from '@decks/templates/Slide.astro';

// The setup for the audit, and it is meant to be DRIVEN rather than
// talked over. The bench opens with the touchscreen simulation on and
// drag as the only reorder path, so the handle genuinely is not there.
//
// Specimen alone is 620 x 235; at scale 1.6 that is 992 x 376.
---

<Slide subtitle="What is left when hover is not available">
	<div class="grid gap-13">
		<div class="text-strong max-w-[1500px] text-5xl">
			A handle that appears on hover is exactly what a keyboard, a touchscreen and a
			screen reader cannot use.
		</div>
		<iframe
			src="/decks/2026-checklist-component/prototypes/c4-accessibility-bench?embed=1&scale=1.6&reorder=drag&coarse=1&focus=object"
			title="The handle, with no hover available"
			class="live-embed m-0! block h-[432px] w-[1048px] max-h-none! max-w-none! border-0"
		></iframe>
		<div class="text-subdued text-3xl">
			Try to move a row. <span class="text-strong">Not small. Absent.</span>
		</div>
	</div>
</Slide>
