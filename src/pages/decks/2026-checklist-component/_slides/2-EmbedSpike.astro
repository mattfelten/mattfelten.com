---
import Slide from '@decks/templates/Slide.astro';

// Reference implementation for every live-embed slide. Raw iframe for now;
// LiveEmbed.astro (Gate 7) wraps this and adds blank-on-exit.
//
// Sizing is measured, not guessed. In embed mode each bench reports its
// natural content box, and the iframe is that box plus the 28px padding
// on each side:
//
//   mechanics  620 x 357   presence  1120 x 365   reorder  620 x 409
//
// scale multiplies those. The deck is 1920 wide and gets scaled down to
// whatever is projecting, so a specimen at 1:1 lands near 10px on screen.
// scale=1.6 buys that back: reorder becomes 992 x 655, so the frame is
// 992+56 by 655+56.
//
// Gate 0 established that keys inside an iframe never reach Reveal, so
// the deck simply will not advance while focus is in here. Escape inside
// any bench blurs to the parent and hands navigation back.
---

<Slide subtitle="Live embed">
	<iframe
		src="/decks/2026-checklist-component/prototypes/reorder-bench?embed=1&grab=both&scale=1.6"
		title="Checklist reorder bench"
		class="live-embed m-0! block h-[711px] w-[1048px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
