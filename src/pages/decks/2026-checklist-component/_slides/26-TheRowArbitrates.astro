---
import TextBlockSlide from '@decks/templates/TextBlockSlide.astro';

// Keep only if 24 lands. The point is that it is not four peers: one
// row arbitrates, and three capabilities get granted to it.

const items = [
	{
		title: 'The text',
		body: 'Editing wants a block. Reordering wants an inline.',
	},
	{
		title: 'The gutter',
		body: 'Presence wants the avatar. Focus wants a rule.',
	},
	{
		title: 'The menu',
		body: 'Carries reordering&rsquo;s non-drag path and editing&rsquo;s entry.',
	},
	{
		title: 'The tab order',
		body: 'Three of them contribute a stop.',
	},
];
---

<TextBlockSlide
	subtitle="The system → They do not compose on their own"
	items={items}
	cols={4}
	bodySize="2xl"
/>
