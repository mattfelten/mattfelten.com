---
import Slide from '@decks/templates/Slide.astro';

// Two rejections in one prototype. The hairline is visible on arrival
// because the row is already open, and it is built the naive way, so
// the border and padding are real and take space.
//
// Click out and back in to show the move: 9px right, 7px down, and
// 14px pushed onto every row below. The chosen version measures 0px
// and 0px, because it paints with background and box-shadow, which
// sit outside layout.
---

<Slide subtitle="Editing → Ruled out: a field with edges">
	<iframe
		src="/decks/2026-checklist-component/prototypes/edit-mechanics-bench?embed=1&scale=2&chrome=field&naive=1&autoedit=1"
		title="A hairline field, built the naive way"
		class="live-embed m-0! block h-[588px] w-[1296px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
