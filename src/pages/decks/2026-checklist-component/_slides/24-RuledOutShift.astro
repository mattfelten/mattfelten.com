---
import Slide from '@decks/templates/Slide.astro';

// Only reads well with uniform-height rows. These are markdown, so a
// tall item displacing short ones slides the target out from under
// the cursor.
//
// scale 2, matching every other bench embed in the segment. At 1.6 the
// component appeared to shrink between slides, which is a change the
// audience has to stop and explain to itself. The neighbours this used
// to name were cut in the restructure; the rule is not about those two
// slides, it is that the specimen never changes size mid-segment.
---

<Slide subtitle="Rows shift out of the way" badge="Rejected">
	<iframe
		src="/decks/2026-checklist-component/prototypes/reorder-bench?embed=1&scale=2&grab=both&drop=shift&fit=center"
		title="Live shift, the rejected drop feedback"
		class="live-embed m-0! block h-[800px] w-[1640px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
