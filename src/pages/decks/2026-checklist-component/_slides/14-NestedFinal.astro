---
import Slide from '@decks/templates/Slide.astro';

// Groups do not fold, so the gutter holds one control and the handle
// sits at the same x-position on every row, parent or not. Folding is
// a capability a list could opt into, and if it ever does it belongs
// in the row menu, for the same reason Move up and Move down are
// there.
//
// The handle is hover-only. Hover a row to raise it.
---

<Slide subtitle="Nested items">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c1-nesting-bench?embed=1&scale=2&nosr=1&nesting=on&nest=independent"
		title="Sub-items one level deep, live"
		class="live-embed m-0! block h-[752px] w-[1296px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
