---
import Slide from '@decks/templates/Slide.astro';

// handles=1 pins the drag handle on. It is hover-only by design, and
// a slide never hovers, so a parent looked as though nesting had
// taken its handle away. Parent rows now show the twisty and the
// handle side by side, which answers the question before it is asked.
//
// The list also gained a 22px left gutter, because two things live
// in it now and the parent handle at -42 was falling outside the
// specimen and being clipped.
---

<Slide subtitle="Nested items">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c1-nesting-bench?embed=1&scale=2&nosr=1&handles=1&nesting=on&nest=independent"
		title="Sub-items one level deep, live"
		class="live-embed m-0! block h-[700px] w-[1296px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
