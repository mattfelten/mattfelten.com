---
import Slide from '@decks/templates/Slide.astro';

// The hinge of the deck. This is where interaction design runs out, said
// plainly, so the accessibility beat three slides later reads as the
// answer rather than as another topic.
//
// The CSS property, the eight arrangements and the scorecard all get
// said out loud. The slide carries the claim and the count.

const claims = [
	['Reordering wants', 'display: inline'],
	['Editing wants', 'display: block'],
	['Selection is not optional', 'no toolbar, no format bar'],
];
---

<Slide subtitle="Three gestures, one row">
	<div class="grid gap-13">
		<div class="text-strong text-5xl">
			Reordering, editing and selecting all want the same pixels.
		</div>
		<div class="grid grid-cols-3 gap-7">
			{
				claims.map(([who, what]) => (
					<div>
						<div class="text-subdued text-xs font-medium uppercase">{who}</div>
						<div class="text-strong mt-3 text-3xl font-medium">{what}</div>
					</div>
				))
			}
		</div>
		<div class="text-subdued text-3xl">
			<span class="text-strong">Eight arrangements. None keeps all three.</span> The best
			manages two, and interaction design cannot rank the losses.
		</div>
	</div>
</Slide>
