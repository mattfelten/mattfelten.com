---
import Slide from '@decks/templates/Slide.astro';

// What the component is made of, drawn rather than listed. Three nested
// levels, each with its own colour, so the containment is the diagram
// rather than something said over it:
//
//   Checklist        the list, and the one thing that owns order
//   ChecklistRow     one row, and the arbiter between the parts below
//   the parts        what a row is assembled from
//
// The nested row is drawn as a real child so the one-level ceiling is
// visible: a sub-row has the same parts as any other row, which is the
// argument that nesting is a capability rather than a second component.
//
// Hand-drawn in CSS rather than an image, because the labels have to be
// readable across a room and an exported diagram would not scale with
// the deck.

const parts = [
	'DragHandle',
	'Checkbox',
	'EditableText',
	'CreatorBadge',
	'RowActions',
];
---

<Slide subtitle="Component Structure">
	<div class="diagram">
		<div class="box list">
			<span class="tag">Checklist</span>

			<div class="box row">
				<span class="tag">ChecklistRow</span>
				<div class="parts">
					{parts.map((p) => <span class="part">{p}</span>)}
				</div>
			</div>

			<div class="box row nested">
				<span class="tag">ChecklistRow</span>
				<span class="note">nested, one level</span>
				<div class="parts">
					{parts.map((p) => <span class="part">{p}</span>)}
				</div>
			</div>

			<div class="box row">
				<span class="tag">ChecklistRow</span>
				<div class="parts">
					{parts.map((p) => <span class="part">{p}</span>)}
				</div>
			</div>

			<div class="box composer">
				<span class="tag">ChecklistComposer</span>
			</div>
		</div>
	</div>
</Slide>

<style>
	/* One hue per level, set directly on the box rather than through a
	   second variable. The indirection was one var() too many: an
	   undefined channel list makes the whole declaration invalid at
	   computed-value time, so the box silently inherited its parent's
	   colour instead of failing loudly.
	   Every hue is alpha over whatever the slide background is, so the
	   diagram works in both colour schemes without a second palette. */
	.diagram {
		display: flex;
		justify-content: center;
	}

	.box {
		position: relative;
		border-radius: 16px;
		border: 2px dashed rgb(var(--hue) / 0.5);
		background: rgb(var(--hue) / 0.07);
		padding: 44px 28px 28px;
	}

	/* The tag names the box it sits in, so it takes that box's hue. */
	.tag {
		position: absolute;
		top: 10px;
		left: 20px;
		font-size: 20px;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: rgb(var(--hue) / 1);
	}

	.list {
		--hue: 156 163 175;
		width: 1400px;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.row {
		--hue: 61 223 194;
		padding: 40px 20px 20px;
	}

	/* A sub-row is a real child of the list, indented, with exactly the
	   parts every other row has. */
	.nested {
		margin-left: 72px;
	}

	/* Its own hue, because it is not a row. It sits in the list and has
	   none of a row's parts: no checkbox, no handle, nothing to drag. */
	.composer {
		--hue: 245 158 11;
		padding: 40px 20px 22px;
	}

	.note {
		position: absolute;
		top: 12px;
		right: 20px;
		font-size: 17px;
		color: rgb(156 163 175 / 0.9);
	}

	.parts {
		display: flex;
		gap: 16px;
		align-items: stretch;
	}

	.part {
		--hue: 139 124 246;
		flex: none;
		border-radius: 10px;
		border: 2px dashed rgb(var(--hue) / 0.55);
		background: rgb(var(--hue) / 0.12);
		color: rgb(var(--hue) / 1);
		padding: 14px 18px;
		font-size: 20px;
		font-weight: 500;
	}

	/* The text is the only part that takes whatever room is left, which
	   is true of the component too. */
	.part:nth-child(3) {
		flex: 1 1 auto;
	}
</style>
