---
import Slide from '@decks/templates/Slide.astro';

// Ending on the open problem rather than a summary. A panel trusts a
// deck more when it names what is still wrong, and this is a real
// correctness hole rather than a polish item.
//
// The reason it is hard (the honest fix probably costs the row its lack
// of chrome) gets said out loud.
---

<Slide subtitle="Still open">
	<div class="grid gap-13">
		<div class="text-strong max-w-[1500px] text-5xl">
			Autosave with no Save button has no failure surface. A failed write is silent
			data loss.
		</div>
		<div class="grid grid-cols-2 gap-7">
			<div>
				<div class="text-subdued text-xs font-medium uppercase">Read-only</div>
				<div class="text-subdued mt-3 text-2xl">
					Says no only by the pointer not turning into a caret.
				</div>
			</div>
			<div>
				<div class="text-subdued text-xs font-medium uppercase">A nested list</div>
				<div class="text-subdued mt-3 text-2xl">
					Has no expanded state, so the twisty's children are implied, not announced.
				</div>
			</div>
		</div>
		<div class="text-subdued text-3xl">
			Every other decision here
			<span class="text-strong">assumes saving works.</span>
		</div>
	</div>
</Slide>
