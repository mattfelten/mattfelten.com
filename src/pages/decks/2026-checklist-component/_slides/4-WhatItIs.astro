---
import Slide from '@decks/templates/Slide.astro';

// The decomposition, with the caveat attached rather than left implied.
// Claiming a shipped library here would be the one dishonest slide in
// the deck, and a systems panel will ask.
//
// What each primitive means gets said out loud, so it is not on the
// slide. One line each.

const parts = [
	['ListRow', 'Layout, states, the gutter, hit areas.'],
	['EditableText', 'Inline edit, autosave, the format affordance.'],
	['SortableList', 'Manual order, drag, and the path that is not a drag.'],
	['PresenceMarker', 'Who is in a row, and what they are doing to it.'],
];
---

<Slide subtitle="What the system would own">
	<div class="grid gap-13">
		<div class="grid grid-cols-2 gap-7">
			{
				parts.map(([name, body]) => (
					<div>
						<div class="text-strong text-4xl font-medium">{name}</div>
						<div class="text-subdued mt-3 text-2xl">{body}</div>
					</div>
				))
			}
		</div>
		<div class="text-subdued text-3xl">
			A decomposition, <span class="text-strong">not shipped packages.</span>
		</div>
	</div>
</Slide>
