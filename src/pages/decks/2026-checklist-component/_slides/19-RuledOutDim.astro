---
import Slide from '@decks/templates/Slide.astro';

// The dim only exists while somebody is mid-keystroke, and the old
// scheduler waited a random two to five seconds before anything
// happened, so the slide showed an ordinary list and the rejection
// was invisible. Solo starts typing immediately: measured, the dim is
// on screen at about one second and in 21 of 24 half-second samples.
//
// 2.67:1 against the 4.5:1 required, and no opacity value saves it,
// because the treatment works by weakening the text and the text is
// what has to stay readable.
---

<Slide subtitle="Multiplayer → Ruled out: dimming the row">
	<iframe
		src="/decks/2026-checklist-component/prototypes/edit-presence-bench?embed=1&scale=1.45&solo=1&mark=floatdim"
		title="The presence dim, rejected on measurement"
		class="live-embed m-0! block h-[364px] w-[1680px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
