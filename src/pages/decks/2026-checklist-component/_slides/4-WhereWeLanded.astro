---
import Slide from '@decks/templates/Slide.astro';

// Everything at once, which is the point: reordering by drag and by
// menu, editing in place, sub-items one level deep, and somebody else
// in the second row.
//
// handles=1 pins the drag handle on, because hover does not exist on
// a slide and the affordance would otherwise be invisible in the one
// place it has to be seen.
//
// Drive it: collapse the parent, drag it and watch its children come
// with it, then open the row menu on a child.
---

<Slide subtitle="Where we landed">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c4-accessibility-bench?embed=1&scale=2.1&reorder=both&enter=menu&focus=object&presence=tint&handles=1"
		title="The component, live"
		class="live-embed m-0! block h-[632px] w-[1358px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
