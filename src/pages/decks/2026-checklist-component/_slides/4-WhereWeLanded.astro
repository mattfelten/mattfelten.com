---
import Slide from '@decks/templates/Slide.astro';

// Everything at once, which is the point: reordering by drag and by
// menu, editing in place, sub-items one level deep, and somebody else
// in the second row.
//
// The handle is hover-only and stays that way. The deck is a web page,
// so hovering a row in front of the panel reveals it exactly as it
// would in the product. An earlier version pinned it visible to work
// around a problem that does not exist.
//
// This is the full component, and it has to stay that way: it is the
// only slide that claims to show everything at once.
//
// Drive it, roughly in this order:
//   hover a row to raise its handle
//   drag a parent and watch its children come with it
//   drop an item onto another row to make it a sub-item
//   drag that sub-item back out to a gap between two top-level rows
//   try to drop a row that HAS sub-items onto another: it goes red and
//     says why, because one level is the ceiling
//   select a few words to raise the formatting bar
//   open the row menu for Move up and Move down
---

<Slide subtitle="Where we landed">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c4-accessibility-bench?embed=1&scale=2&reorder=both&enter=menu&focus=object&presence=bar&fit=center"
		title="The component, live"
		class="live-embed m-0! block h-[800px] w-[1640px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
