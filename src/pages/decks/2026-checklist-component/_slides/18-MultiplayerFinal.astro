---
import Slide from '@decks/templates/Slide.astro';

// solo=1 is the whole point of this slide. The bench was built as two
// screens side by side, which demonstrates that a keystroke on the
// left arrives on the right. That is the plumbing. What matters here
// is what it feels like to watch your own list change under you, so
// the second screen goes and one person works from off screen.
//
// It also starts mid-action rather than waiting out a timer. Nothing
// is said over this slide for the first few seconds; just let them
// watch a row they did not touch start changing.
---

<Slide subtitle="Multiplayer">
	<iframe
		src="/decks/2026-checklist-component/prototypes/edit-presence-bench?embed=1&scale=1.6&solo=1&mark=float&fit=center"
		title="Somebody else working in the list, live"
		class="live-embed m-0! block h-[800px] w-[1704px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
