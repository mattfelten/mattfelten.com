---
import Slide from '@decks/templates/Slide.astro';
import { CLASS, tokenise } from './_code.ts';

// The shapes, before the usage. Without this the next slide is a list of
// opaque identifiers: items, whoIsHere, move, save. Showing what one row
// actually is makes two arguments at once, and both matter more than the
// prop names do.
//
// One: a row is five fields. Everything in this deck, every gesture and
// every rejected direction, is in service of five fields and a boolean.
//
// `checked` rather than `done`, because the component knows the box is
// ticked and not what that means to the consumer. A runbook step that is
// checked is completed; a discussion item that is checked might be
// agreed, covered, or dropped. Naming it `done` would be the component
// deciding the meaning of its own data, which is the line it holds
// everywhere else.
//
// Two: parentId is the whole nesting model. One nullable field is what
// "one level" costs in the data, which is why turning nesting off can
// flatten rather than migrate.
//
// The handlers take neighbour ids rather than an index, because that is
// the fractional-index decision surfacing in the API: the server
// resolves the position inside the transaction, so two people reordering
// at once cannot write the same slot.

const item = `type ChecklistItem = {
  id: string
  text: string          // markdown
  checked: boolean      // the box, not what it means to you
  author: string        // shown in the creator badge
  parentId: string | null   // the entire nesting model
}`;

// Presence is a separate array rather than a field on the item, which is
// the question worth being ready for. Items are persisted and change
// when somebody saves; presence is ephemeral and changes many times a
// second. Putting it on the item means every heartbeat produces a new
// items array, so the whole list re-renders and any memoisation on a row
// is defeated. They also arrive from different places: items from the
// API, presence from a live channel. Two lifetimes, two props.
const presence = `type PresenceUser = {
  itemId: string        // the component does the join
  name: string          // announced, not just drawn
}`;

const handlers = `const move = (id, { after, before }) => api.reorder(...)   // neighbours, never an index
const save = (id, text) => api.updateItem(id, text)            // fires on autosave, not on blur`;

const blocks: { label: string; code: string; wide?: boolean }[] = [
	{ label: 'One row', code: item },
	{ label: 'Who is in the list, and not on the item', code: presence },
	{ label: 'What comes back out', code: handlers, wide: true },
];

// Two columns rather than three stacked blocks: stacked, the slide ran
// past the bottom of the padded area. The row shape sits alone on the
// left because it is the one worth reading line by line.
---

<Slide subtitle="What you hand it">
	<div class="grid grid-cols-2 items-start gap-x-14 gap-y-8">
		{
			blocks.map((b) => (
				<div class:list={['flex flex-col gap-3', b.wide && 'col-span-2']}>
					<span class="text-subdued text-xs font-medium uppercase">
						{b.label}
					</span>
					<pre class="snippet"><code>{tokenise(b.code, 'ts').map((tk) => (
						tk.k === 'ws' ? tk.t : <span class={CLASS[tk.k]}>{tk.t}</span>
					))}</code></pre>
				</div>
			))
		}
	</div>
</Slide>

<style>
	.snippet {
		margin: 0;
		border-radius: 16px;
		border: 1px solid rgb(156 163 175 / 0.25);
		background: rgb(156 163 175 / 0.08);
		padding: 20px 28px;
		font-size: 21px;
		line-height: 1.55;
		overflow-x: auto;
	}
</style>
