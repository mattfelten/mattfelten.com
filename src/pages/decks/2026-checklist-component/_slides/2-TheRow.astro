---
import Slide from '@decks/templates/Slide.astro';

// The specimen, live, in its settled configuration. A bench always opens
// in the decided state rather than the state that best argues the
// problem, so this is the row as it would ship.
//
// Measured, not guessed: in embed mode this bench reports 620 x 235, so
// at scale 1.6 it is 992 x 376, and the frame is that plus the 28px of
// padding on each side.
---

<Slide subtitle="The row">
	<div class="grid gap-12">
		<div class="text-strong max-w-[1180px] text-5xl">
			One row. It checks off, it reorders, it edits in place, and other people are in
			it while you are.
		</div>
		<iframe
			src="/decks/2026-checklist-component/prototypes/c4-accessibility-bench?embed=1&scale=1.6&reorder=both&enter=menu&focus=object&presence=bar"
			title="Checklist specimen"
			class="live-embed m-0! block h-[432px] w-[1048px] max-h-none! max-w-none! border-0"></iframe>
	</div>
</Slide>
