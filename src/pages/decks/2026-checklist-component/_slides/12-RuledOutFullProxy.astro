---
import Slide from '@decks/templates/Slide.astro';

// The proxy now carries the person badge, because every row carries
// one. Without it this was not a picture of the row you picked up, it
// was a picture of a simpler row, and the comparison against the
// collapsed proxy was not like for like.
//
// Drag the tallest row: a full height block covers the list you are
// aiming at. The thing in your hand only has to say which row it is.
---

<Slide subtitle="Reordering → Row follows cursor" badge="Rejected">
	<iframe
		src="/decks/2026-checklist-component/prototypes/reorder-bench?embed=1&scale=2&grab=both&drop=line&proxy=full"
		title="The full-height drag proxy, rejected"
		class="live-embed m-0! block h-[776px] w-[1296px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
