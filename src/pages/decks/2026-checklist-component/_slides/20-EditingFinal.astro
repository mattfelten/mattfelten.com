---
import Slide from '@decks/templates/Slide.astro';

// autoedit=1 opens the first row on arrival. The whole decision is
// that there is nothing to see, so a closed field shows an ordinary
// list and the point is missed. The top row IS being edited here.
// That is the slide.
---

<Slide subtitle="Editing">
	<iframe
		src="/decks/2026-checklist-component/prototypes/edit-mechanics-bench?embed=1&scale=2&chrome=none&enter=text&autoedit=1&fit=center"
		title="The invisible field, already open"
		class="live-embed m-0! block h-[800px] w-[1640px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
