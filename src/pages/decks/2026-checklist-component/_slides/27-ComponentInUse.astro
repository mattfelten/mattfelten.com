---
import Slide from '@decks/templates/Slide.astro';

// The same component, twice, which is the whole argument on one slide:
// Loops and Runbooks differ by four lines of configuration, not by being
// two components. Worth saying out loud that the Runbooks call is the
// shorter one, because a consumer that declines a capability should not
// have to know it exists.

const loops = `<Checklist
  items={items}
  reorderable
  nesting="one-level"
  editable
  showCreator
  presence={whoIsHere}
  onReorder={move}
  onEdit={save}
/>`;

const runbooks = `<Checklist
  items={steps}
  nesting="one-level"
  onEdit={save}
/>`;
---

<Slide subtitle="The same component, twice">
	<div class="grid grid-cols-2 gap-16">
		<div class="flex flex-col gap-4">
			<span class="text-subdued text-xs font-medium uppercase">
				Collaboration Loops
			</span>
			<pre class="snippet"><code>{loops}</code></pre>
		</div>
		<div class="flex flex-col gap-4">
			<span class="text-subdued text-xs font-medium uppercase">
				Runbooks
			</span>
			<pre class="snippet"><code>{runbooks}</code></pre>
			<span class="text-subdued text-2xl">
				Read mostly, authored briefly. It declines reordering, presence
				and the author tag, and never has to know they exist.
			</span>
		</div>
	</div>
</Slide>

<style>
	.snippet {
		margin: 0;
		border-radius: 16px;
		border: 1px solid rgb(156 163 175 / 0.25);
		background: rgb(156 163 175 / 0.08);
		padding: 28px 32px;
		font-size: 24px;
		line-height: 1.6;
		overflow-x: auto;
	}
</style>
