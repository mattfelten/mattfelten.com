---
import Slide from '@decks/templates/Slide.astro';

// The slide that makes the previous one worth showing. Four boxes is a
// diagram; this is the answer to "how do they go together", which is
// that they do not, and the row referees.
//
// Every row of this table is a callback to something already on screen,
// which is why it goes after accessibility rather than before.

const arbitrations = [
	['The text', 'Editing wants a block. Reordering wants an inline.'],
	['The gutter', 'Presence wants the avatar. Focus wants a rule.'],
	['The menu', 'Carries reordering&rsquo;s non-drag path and editing&rsquo;s entry.'],
	['The tab order', 'Three of them contribute a stop.'],
];
---

<Slide subtitle="The system → They do not compose on their own">
	<div class="grid gap-9">
		<div class="text-strong max-w-[1500px] text-5xl">
			Everything in the last fifteen minutes was one of them arguing with another.
		</div>
		<div class="grid grid-cols-4 gap-7">
			{
				arbitrations.map(([what, who]) => (
					<div>
						<div class="text-strong text-3xl font-medium">{what}</div>
						<div class="text-subdued mt-2 text-xl" set:html={who} />
					</div>
				))
			}
		</div>
		<div class="text-subdued text-3xl">
			So not four peers. <span class="text-strong">One row that arbitrates</span>, plus
			three capabilities it can be granted. And three things it refuses to decide: who may
			edit, how merging is implemented, and how the menu behaves once open.
		</div>
	</div>
</Slide>
