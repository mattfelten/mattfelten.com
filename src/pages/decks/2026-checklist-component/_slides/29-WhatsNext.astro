---
import Slide from '@decks/templates/Slide.astro';

// Replaces the outcome slide. The outcome was a scoreboard, and a
// scoreboard is the least interesting thing to end on: it invites
// nodding rather than questions. These are the live threads, and two of
// them are open enough that the panel can push on them, which is the
// better last minute.
//
// The order is deliberate: the correctness problem first, because it is
// the one that would keep me up, then the two design questions, then the
// thing I would want to be told I am wrong about.

const items = [
	{
		title: 'Autosave has no failure surface',
		body: 'No Save button means no place for a failed write to land, which makes it silent data loss. The only correctness problem still open, and the first thing I would build next.',
	},
	{
		title: 'Does anybody want a second level',
		body: 'One level is a ceiling I chose, not one anybody asked for. Runbooks is the consumer most likely to want depth, and I would rather ask than find out.',
	},
	{
		title: 'Does multiplayer still need a lock',
		body: 'Merging removes the reason for one. If people keep talking over each other in the same row, the answer is probably presence that is louder, not a lock.',
	},
	{
		title: 'Targets are 24, and that is the floor',
		body: 'It clears AA on a mouse. On a thumb it is small, and the platform guidance is 44. Growing them under a coarse pointer is the obvious next move.',
	},
];
---

<Slide subtitle="What I would do next">
	<div class="grid grid-cols-2 gap-x-16 gap-y-10">
		{
			items.map((i) => (
				<div class="flex flex-col gap-3">
					<span class="text-strong text-3xl font-medium">{i.title}</span>
					<span class="text-subdued text-2xl">{i.body}</span>
				</div>
			))
		}
	</div>
</Slide>
