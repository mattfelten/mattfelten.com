---
import Slide from '@decks/templates/Slide.astro';

// The sharpest single argument that this is one component and not two,
// so the slide leads with that rather than with the drag model.
//
// The "3 of 5 with eight rows on screen" bug is a good thing to tell
// rather than print, so it stays off the slide.
//
// Nesting bench, embed, nosr=1 to drop the announced-structure panel:
// 620 x 409 at scale 1.4 is 868 x 573.
---

<Slide subtitle="Sub-items, one level">
	<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-12">
		<div class="grid gap-13">
			<div class="text-strong text-5xl">
				Nesting is a capability, not a fact about the component.
			</div>
			<div>
				<div class="text-subdued text-xs font-medium uppercase">Switched off</div>
				<div class="text-subdued mt-3 text-3xl">
					No twisties. No dropping onto a row. The line never insets.
				</div>
			</div>
			<div class="text-subdued text-3xl">
				A flat agenda and a nested runbook are
				<span class="text-strong">one thing configured differently.</span>
			</div>
		</div>
		<iframe
			src="/decks/2026-checklist-component/prototypes/c1-nesting-bench?embed=1&scale=1.4&nosr=1&nesting=on&nest=independent"
			title="Nesting bench"
			class="live-embed m-0! block h-[629px] w-[924px] max-h-none! max-w-none! border-0"
		></iframe>
	</div>
</Slide>
