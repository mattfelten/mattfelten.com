---
import Slide from '@decks/templates/Slide.astro';

// Try to type in the row they are holding. A lock is not a design, it
// is scaffolding: it is what you build when you have given up on
// merging, and it teaches a habit that has to be untrained the moment
// real collaborative editing lands.
---

<Slide subtitle="Multiplayer → Lock the row" badge="Rejected">
	<iframe
		src="/decks/2026-checklist-component/prototypes/edit-presence-bench?embed=1&scale=1.45&solo=1&mark=float&lock=locked"
		title="A hard hold on the row, rejected"
		class="live-embed m-0! block h-[402px] w-[1680px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
