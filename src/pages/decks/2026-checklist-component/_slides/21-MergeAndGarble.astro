---
import Slide from '@decks/templates/Slide.astro';

// The answer the previous slide owes. Rejecting the lock leaves 'then
// what', and merging is the thing that replaces it.
//
// autocollide=1 stages the collision, because embed mode hides the rail
// and Marco is only drivable from there. It stops one click short: Dana
// has typed and not saved, Marco's change is already stored.
//
// Drive it: press Save on Dana's screen. Both edits land in one
// sentence, and where they touched the same words it keeps both rather
// than choosing, which is the garbled text somebody tidies.
//
// Measured at 1600 wide, scale 1.8: 690px.
---

<Slide subtitle="Multiplayer → So merge, and accept that it garbles">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c3-concurrency-bench?embed=1&scale=1.8&strategy=merge&autocollide=1&fit=center"
		title="Two people, one item, one save away from merging"
		class="live-embed m-0! block h-[800px] max-h-none! w-[1600px] max-w-none! border-0"
	></iframe>
</Slide>
