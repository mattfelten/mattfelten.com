---
import Slide from '@decks/templates/Slide.astro';

// The props are the decisions, restated as a surface. Every one of them
// is a call made earlier in this deck, which is the point: a consumer
// configures the component by answering the same questions, and the ones
// that are not props are the ones the component refuses to let a
// consumer get wrong.
//
// `nesting` is the sharpest of them. A flat agenda and a nested runbook
// are one thing configured differently, and that is the argument that
// this is a component and not two.
//
// A real table, with rules between the rows. Three columns of loose text
// read as a list of sentences; the rules are what make it scan as an
// API. Headers are small and quiet: they name the columns once and then
// get out of the way.

const props = [
	{
		name: 'items',
		type: 'ChecklistItem[]',
		note: 'Order comes from the array. The component never sorts.',
	},
	{
		name: 'reorderable',
		type: 'boolean',
		note: 'The handle and the Move up / Move down menu items, together. Never one without the other.',
	},
	{
		name: 'nesting',
		type: "'off' | 'one-level'",
		note: 'Off withdraws the gesture and the affordance, and flattens the data.',
	},
	{
		name: 'editable',
		type: 'boolean',
		note: 'Inline edit and autosave. Who may edit is the consumer&rsquo;s call, not this flag.',
	},
	{
		name: 'presence',
		type: 'PresenceUser[]',
		note: 'Who is in which row. The component draws it and never fetches it.',
	},
	{
		name: 'showCreator',
		type: 'boolean',
		note: 'The author tag. Runbooks does not want one.',
	},
	{
		name: 'onReorder, onEdit, onCreate, onDelete',
		type: 'callbacks',
		note: 'Intent out, new items in. The component holds no server state.',
	},
];
---

<Slide subtitle="Component API">
	<table class="api">
		<thead>
			<tr>
				<th>Prop</th>
				<th>Type</th>
				<th>What it does</th>
			</tr>
		</thead>
		<tbody>
			{
				props.map((p) => (
					<tr>
						<td class="name">{p.name}</td>
						<td class="type">{p.type}</td>
						<td class="note" set:html={p.note} />
					</tr>
				))
			}
		</tbody>
	</table>
</Slide>

<style>
	.api {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
	}

	.api th {
		font-size: 16px;
		font-weight: 500;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--color-weak);
		padding-bottom: 16px;
		white-space: nowrap;
	}

	/* The rule belongs to the row above it, so the header keeps a slightly
	   stronger one and the body rows share a quieter repeat. */
	.api thead tr {
		border-bottom: 1px solid rgb(156 163 175 / 0.35);
	}

	.api tbody tr + tr {
		border-top: 1px solid rgb(156 163 175 / 0.16);
	}

	.api td {
		padding: 18px 0;
		vertical-align: baseline;
		font-size: 24px;
	}

	.api td + td {
		padding-left: 40px;
	}

	.name {
		color: var(--color-strong);
		font-weight: 500;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		white-space: nowrap;
	}

	.type {
		color: var(--color-accent);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		white-space: nowrap;
	}

	.note {
		color: var(--color-subdued);
		width: 100%;
	}
</style>
