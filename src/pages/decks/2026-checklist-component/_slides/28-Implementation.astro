---
import Slide from '@decks/templates/Slide.astro';
import { CLASS, tokenise } from './_code.ts';

// The same component, twice, which is the whole argument on one slide:
// Loops and Runbooks differ by four lines of configuration, not by being
// two components. Worth saying out loud that the Runbooks call is the
// shorter one, because a consumer that declines a capability should not
// have to know it exists.
//
// Coloured with the deck's own palette rather than an editor theme. The
// props take the same violet the structure diagram gives the parts of a
// row, so the two slides read as the same subject: on one it is a box in
// a diagram, on the other it is the prop that turns the box on.

const loops = `<Checklist
  items={items}
  reorderable
  nesting
  editable
  showCreator
  onReorder={move}
  onEdit={save}
/>`;

const runbooks = `<Checklist
  items={steps}
  nesting
  onEdit={save}
/>`;

// No commentary under the Runbooks call. The shorter call is the
// argument, and saying it in prose underneath only takes the line away
// from Matt.
const panels = [
	{ label: 'Collaboration Loops', code: loops },
	{ label: 'Runbooks', code: runbooks },
];
---

<Slide subtitle="Implementation">
	<div class="grid grid-cols-2 items-start gap-16">
		{
			panels.map((p) => (
				<div class="flex flex-col gap-4">
					<span class="text-strong text-3xl font-medium">{p.label}</span>
					<pre class="snippet"><code>{tokenise(p.code).map((tk) => (
						tk.k === 'ws' ? tk.t : <span class={CLASS[tk.k]}>{tk.t}</span>
					))}</code></pre>
				</div>
			))
		}
	</div>
</Slide>

<style>
	.snippet {
		margin: 0;
		border-radius: 16px;
		border: 1px solid rgb(156 163 175 / 0.25);
		background: rgb(156 163 175 / 0.08);
		padding: 28px 32px;
		font-size: 24px;
		line-height: 1.6;
		overflow-x: auto;
	}
</style>
