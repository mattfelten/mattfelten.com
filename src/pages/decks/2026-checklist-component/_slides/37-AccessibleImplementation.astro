---
import Slide from '@decks/templates/Slide.astro';

// Four, not eight, and a single row rather than the four by two grid the
// audit slide uses. Two slides with the same shape read as one slide
// shown twice, and the eye stops looking.
//
// What came out, and why, so nobody puts it back:
//   Announcing changes from elsewhere. Obvious for a system component:
//     it is not going to narrate things that happen outside it.
//   Owning the menu behaviour. Summed up by "use the system dropdown",
//     which does not need a line of its own.
//   Catching a failed save. Said on the closing slide, where it is the
//     open correctness problem rather than a consumer chore.
//   Re-measuring contrast after a re-theme. Not a thing here: there is
//     one theme.
//
// Headings are short labels rather than sentences, because the body
// underneath is already the sentence.

const steps = [
	{
		title: 'Use object names',
		body: 'Pass a label. The component renders a group of checkboxes and does not know what they are a list of.',
	},
	{
		title: 'Include a section heading',
		body: 'The component owns one region, not the page. Give it a heading somebody can navigate to.',
	},
	{
		title: 'Handle permissions',
		body: 'Set editable per row from your own rules. The component asks the question and never answers it.',
	},
	{
		title: 'Name the people',
		body: 'Presence is announced, not just drawn. Without a name it is an anonymous face a screen reader cannot report.',
	},
];
---

<Slide subtitle="Accessible Implementation">
	<div class="grid grid-cols-4 gap-10">
		{
			steps.map((s) => (
				<div class="flex flex-col gap-4">
					<span class="text-strong text-3xl font-medium">{s.title}</span>
					<span class="text-subdued text-2xl">{s.body}</span>
				</div>
			))
		}
	</div>
</Slide>
