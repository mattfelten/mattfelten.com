---
import Slide from '@decks/templates/Slide.astro';

// deep=1 swaps in a five-level list. Every step costs another 32px of
// the text column, so by the fourth the row is mostly margin. This
// replaces the sideways-drag rejection, which the bench never
// actually demonstrated.
---

<Slide subtitle="Nested items → Ruled out: nesting without a limit">
	<iframe
		src="/decks/2026-checklist-component/prototypes/c1-nesting-bench?embed=1&scale=2&nosr=1&deep=1"
		title="Five levels of nesting, rejected"
		class="live-embed m-0! block h-[492px] w-[1296px] max-h-none! max-w-none! border-0"
	></iframe>
</Slide>
